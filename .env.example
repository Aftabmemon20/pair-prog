# ==============================================================================
# Pairio-Lite "Pair Master" — Environment Configuration
# Copy this file to .env and fill in real credentials.
# NEVER commit .env to version control.
# ==============================================================================

# --- API Service Configuration ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-random-32-byte-hex-string-for-room-tokens

# --- Groq (LLM & Speech-to-Text) ---
# Free Tier Limits:
# LLM: 30 req/min, 1K req/day, 8K tokens/min, 200K tokens/day
# Whisper: 20 req/min, 2K req/day, 7.2K audio-sec/hour
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Supabase (PostgreSQL + Realtime State) ---
# Free Tier: Postgres database, auto-pauses after inactivity (needs keep-alive)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=ey...anon-key
SUPABASE_SERVICE_ROLE_KEY=ey...service-role-key

# --- LiveKit Cloud (WebRTC Audio + Screen Sharing) ---
# Free Tier: 5,000 participant-min/month, 50 GB/month, 100 concurrent
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=sec...

# --- Optional Gemini (Screen Frame Vision - Stretch) ---
GEMINI_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
